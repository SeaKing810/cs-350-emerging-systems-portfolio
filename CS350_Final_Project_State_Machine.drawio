<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="page-1" name="Thermostat state machine">
    <mxGraphModel grid="0" page="1" pageScale="1" pageWidth="1050" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="initialize" style="edgeStyle=none;rounded=0;html=0;strokeWidth=2;strokeColor=#526777;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5037037037037037;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="initial" target="off">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="offheat" style="edgeStyle=none;rounded=0;html=0;strokeWidth=2;strokeColor=#526777;endArrow=block;endFill=1;exitX=1.0;exitY=0.41904761904761906;exitPerimeter=0;entryX=0.0;entryY=0.41904761904761906;entryPerimeter=0;" edge="1" parent="1" source="off" target="heat">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="heatcool" style="edgeStyle=none;rounded=0;html=0;strokeWidth=2;strokeColor=#526777;endArrow=block;endFill=1;exitX=1.0;exitY=0.41904761904761906;exitPerimeter=0;entryX=0.0;entryY=0.41904761904761906;entryPerimeter=0;" edge="1" parent="1" source="heat" target="cool">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cooloff" style="edgeStyle=none;rounded=0;html=0;strokeWidth=2;strokeColor=#526777;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="cool" target="off">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="860" y="472" />
              <mxPoint x="190" y="472" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="title" value="CS 350 Thermostat State Machine" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#172c42;fontStyle=1;align=left;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="20" width="980" height="40" />
        </mxCell>
        <mxCell id="subtitle" value="Thermostat.py  |  UML state notation  |  T = current whole-degree F; S = set point F" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="65" width="980" height="28" />
        </mxCell>
        <mxCell id="events" value="cycle = GPIO 24 press     UP = GPIO 25 press     DOWN = GPIO 12 press" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=19;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="109" width="980" height="30" />
        </mxCell>
        <mxCell id="initial" value="" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;ellipse;strokeColor=#172c42;fillColor=#172c42;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="161" width="22" height="22" />
        </mxCell>
        <mxCell id="initnote" value="Initialize GPIO, I2C, LCD and UART; read T; S := 72" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="155" width="765" height="35" />
        </mxCell>
        <mxCell id="off" value="OFF&#10;entry / both LEDs off&#10;&#10;UP / S := S + 1&#10;DOWN / S := S - 1&#10;Remain in OFF" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#172c42;fontStyle=0;align=center;verticalAlign=middle;spacing=10;rounded=1;arcSize=10;strokeWidth=2;strokeColor=#526777;fillColor=#f0f3f6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="222" width="270" height="210" />
        </mxCell>
        <mxCell id="heat" value="HEAT&#10;entry / evaluate red&#10;T &lt; S: red pulses&#10;T &gt;= S: red solid&#10;Blue always off&#10;exit / red off" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#172c42;fontStyle=0;align=center;verticalAlign=middle;spacing=10;rounded=1;arcSize=10;strokeWidth=2;strokeColor=#526777;fillColor=#fceae7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="390" y="222" width="270" height="210" />
        </mxCell>
        <mxCell id="cool" value="COOL&#10;entry / evaluate blue&#10;T &gt; S: blue pulses&#10;T &lt;= S: blue solid&#10;Red always off&#10;exit / blue off" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#172c42;fontStyle=0;align=center;verticalAlign=middle;spacing=10;rounded=1;arcSize=10;strokeWidth=2;strokeColor=#526777;fillColor=#e9f2fd;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="725" y="222" width="270" height="210" />
        </mxCell>
        <mxCell id="cycle1" value="cycle" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#172c42;fontStyle=0;align=center;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="329" y="275" width="57" height="28" />
        </mxCell>
        <mxCell id="cycle2" value="cycle" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#172c42;fontStyle=0;align=center;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="664" y="275" width="57" height="28" />
        </mxCell>
        <mxCell id="cycle3" value="cycle" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#172c42;fontStyle=0;align=center;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="480" y="453" width="90" height="33" />
        </mxCell>
        <mxCell id="internal" value="Internal events in HEAT and COOL (mode stays unchanged):&#10;UP / S := S + 1; evaluate indicators&#10;DOWN / S := S - 1; evaluate indicators&#10;sample / refresh T; evaluate indicators" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="505" width="650" height="118" />
        </mxCell>
        <mxCell id="solid" value="Solid = selected mode satisfied.&#10;Pulse = active heating/cooling.&#10;At T = S, the selected LED is solid.&#10;No automatic HEAT/COOL change." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="735" y="505" width="290" height="118" />
        </mxCell>
        <mxCell id="stop" value="Any mode: Ctrl+C or fatal I/O error / both LEDs off; close UART; clear LCD; release pins" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="650" width="915" height="28" />
        </mxCell>
        <mxCell id="final" value="" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;shape=doubleEllipse;strokeColor=#172c42;fillColor=#172c42;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="979" y="651" width="22" height="22" />
        </mxCell>
        <mxCell id="legend" value="Notation: event [guard] / action. Conditions in state boxes select the indicator action." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="693" width="945" height="23" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-2" name="Interfaces and timing">
    <mxGraphModel grid="0" page="1" pageScale="1" pageWidth="1050" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Thermostat Interfaces and Timing" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=28;fontColor=#172c42;fontStyle=1;align=left;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="20" width="980" height="40" />
        </mxCell>
        <mxCell id="subtitle" value="Technical specification  |  All GPIO numbers use BCM numbering" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=19;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="65" width="980" height="28" />
        </mxCell>
        <mxCell id="i2c" value="I2C temperature input&#10;AHT20 at 0x38; SDA GPIO 2; SCL GPIO 3.&#10;board.I2C() then adafruit_ahtx0.AHTx0(i2c).&#10;Read Celsius at startup and once per second.&#10;T = floor(C x 9/5 + 32); LCD, control and UART&#10;use this same whole-degree Fahrenheit value." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=10;strokeWidth=2;strokeColor=#526777;fillColor=#f0f3f6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="123" width="478" height="182" />
        </mxCell>
        <mxCell id="gpio" value="GPIO inputs and indicators&#10;Buttons: mode 24; increase 25; decrease 12.&#10;Active-low; pull-ups; 50 ms debounce.&#10;when_pressed queues one event per press.&#10;LEDs: red 18; blue 23; PWMLED control.&#10;Fade: 1 s in + 1 s out; inactive color is off." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=10;strokeWidth=2;strokeColor=#526777;fillColor=#f0f3f6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="537" y="123" width="478" height="182" />
        </mxCell>
        <mxCell id="lcd" value="LCD output&#10;16 x 2; RS/EN/D4/D5/D6/D7 use GPIO&#10;17 / 27 / 5 / 6 / 13 / 26, respectively.&#10;Row 1 always: MM/DD HH:MM:SS (24-hour).&#10;Row 2: Temp: 70F for 5 s, then&#10;HEAT Set:72F for 5 s; repeats in every mode.&#10;Rows are padded; update each second or press." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=10;strokeWidth=2;strokeColor=#526777;fillColor=#e9f2fd;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="328" width="478" height="199" />
        </mxCell>
        <mxCell id="uart" value="UART output&#10;/dev/ttyS0 (configurable with --port).&#10;115200 baud; 8 data bits; no parity; 1 stop bit.&#10;No flow control; 1 s read/write timeouts.&#10;TX GPIO 14; RX GPIO 15; common ground.&#10;Every 30 s: state,T,S plus newline (UTF-8).&#10;Example: heat,70,72\n; first send at t = 30 s." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=10;strokeWidth=2;strokeColor=#526777;fillColor=#e9f2fd;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="537" y="328" width="478" height="199" />
        </mxCell>
        <mxCell id="scheduler" value="Execution and timing" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#172c42;fontStyle=1;align=left;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="553" width="980" height="28" />
        </mxCell>
        <mxCell id="logic" value="GPIO Zero event callbacks enqueue presses; the main loop handles each event in order.&#10;The main loop also owns the sensor, LCD and UART. PWM fades run in the background.&#10;Monotonic deadlines preserve the 1 s and 30 s schedules; LCD page changes use elapsed time.&#10;Late service skips missed timer slots without sending a burst of old records.&#10;Button presses never reset deadlines. Fatal I/O errors stop execution and release resources." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#172c42;fontStyle=0;align=left;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=#ffffff;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="590" width="980" height="120" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>